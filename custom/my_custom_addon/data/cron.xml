<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_vehicle_reservation" model="ir.sequence">
            <field name="name">Reservation Sequence</field>
            <field name="code">vehicle.reservation</field>
            <field name="prefix">RES/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_cron_expire_reservations" model="ir.cron">
            <field name="name">Expire Vehicle Reservations</field>
            <field name="model_id" ref="model_vehicle_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_reservations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
