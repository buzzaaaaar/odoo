<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_vehicle_dealership">
        <field name="name">Vehicle Dealership</field>
        <field name="description">Helps you manage your vehicle dealership.</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_vehicle_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_vehicle_dealership"/>
    </record>

    <record id="group_vehicle_sales_executive" model="res.groups">
        <field name="name">Sales Executive</field>
        <field name="category_id" ref="module_category_vehicle_dealership"/>
        <field name="implied_ids" eval="[(4, ref('group_vehicle_viewer'))]"/>
    </record>

    <record id="group_vehicle_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vehicle_dealership"/>
        <field name="implied_ids" eval="[(4, ref('group_vehicle_sales_executive'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
